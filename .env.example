# Copy to .env and fill in real values.
# MODE controls inference: "openrouter" (default, free open-source LLMs via
# OpenRouter + local faster-whisper) or "local" (Ollama + faster-whisper, offline).
MODE=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key

# Free-tier models rotate constantly and are auto-discovered at runtime
# (filtered to $0 models, ordered by quality, with openrouter/free as the
# ultimate fallback). To PIN a specific list instead, set it as JSON — this
# skips discovery entirely:
# OPENROUTER_MODELS=["qwen/qwen3-next-80b-a3b-instruct:free","openrouter/free"]
# How often (seconds) to refresh the discovered free-model list.
# FREE_MODEL_REFRESH_SECONDS=21600

# Interview tuning
# MAX_QUESTIONS=6
# FOLLOW_UPS_PER_QUESTION=1

# Optional: where temp audio files go (defaults to system temp dir).
# TEMP_DIR=/tmp